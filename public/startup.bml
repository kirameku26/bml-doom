
<?xml version="1.0" encoding="EUC-JP"?>
<?bml bml-version="3.0"?>
<bml>
  <head>
    <title>DOOM Dynamic Framebuffer</title>

    <style><![CDATA[
      body {
        resolution: 960x540;
        background-color: black;
        color: white;
      }

      #frame {
        position: absolute;
        left: 0px;
        top: 0px;
        width: 960px;
        height: 540px;
      }

      #status {
        position: absolute;
        left: 10px;
        top: 10px;
        width: 850px;
        height: 40px;
        font-size: 24px;
        color: yellow;
        background-color: black;
        visibility: hidden;
      }
    ]]></style>

    <script><![CDATA[
      var updates = 0;
      var lastReport = 0;
      var lastUpdate = 0;
      var minGap = 99999;
      var maxGap = 0;

      function refresh() {
        var now = (new Date()).getTime();

        if (lastUpdate != 0) {
          var gap = now - lastUpdate;

          if (gap < minGap) minGap = gap;
          if (gap > maxGap) maxGap = gap;
        }

        lastUpdate = now;

        // Request the newest image module data
        document.getElementById("frame").data =
          "/40/0001/live.jpg";

        updates++;

        var elapsed = now - lastReport;

        if (elapsed >= 1000) {
          var ups = (updates * 1000 / elapsed) | 0;

          document.getElementById("status")
            .firstChild.data =
              "UPS: " + ups +
              " MIN: " + minGap +
              "ms MAX: " + maxGap + "ms";

          updates = 0;
          minGap = 99999;
          maxGap = 0;
          lastReport = now;
        }
      }

      function init() {
        lastReport = (new Date()).getTime();

        browser.setInterval("refresh()", 50, 0);
      }
    ]]></script>
  </head>

  <body onload="init();">
    <object
      id="frame"
      type="image/jpeg"
      data="/40/0001/live.jpg">
    </object>

    <p id="status">Starting...</p>
  </body>
</bml>
